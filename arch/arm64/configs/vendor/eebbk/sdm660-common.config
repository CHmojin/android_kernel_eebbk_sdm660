# Auto local version
CONFIG_LOCALVERSION_AUTO=y

# Haptics
# CONFIG_INPUT_HBTP_INPUT is not set

# Power
CONFIG_QCOM_PRESERVE_MEM=y

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# QCACLD
CONFIG_QCA_CLD_WLAN=y

# Ramdisk
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y

# H7000 debug: lockup / hung task detection
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=10
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=n
CONFIG_LOCKUP_DETECTOR=y
CONFIG_RCU_CPU_STALL_TIMEOUT=10
CONFIG_PANIC_ON_OOPS=n
CONFIG_PANIC_TIMEOUT=0

# eBPF (netd / bpfloader on Android 12+)
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_BPFILTER=y
CONFIG_BPFILTER_UMH=y
